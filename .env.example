# Copy this file to `.env` and adjust as you need it. Every value is optional.

# Port the Node server listens on (put nginx/Caddy in front of it).
PORT=3001

# Address to bind. Keep 127.0.0.1 when a reverse proxy runs on the same host.
HOST=127.0.0.1

# Where the page data, password hash and uploaded images live.
# Defaults to ./server/data. Back this folder up!
# DATA_DIR=/var/lib/trellis

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Traefik) so that
# secure cookies and client IPs (login rate limiting) work correctly.
TRUST_PROXY=1

# HTTPS-only mode. On by default when NODE_ENV=production: http is
# redirected to https, HSTS is sent, cookies are Secure-only and any http://
# asset is upgraded. localhost always works over http. Requires TRUST_PROXY=1
# behind nginx. Set to 0 only if you really serve the site without HTTPS.
# FORCE_HTTPS=1

# Secret used to sign session cookies. If unset, one is generated and stored
# in DATA_DIR/secret.key on first start.
# SESSION_SECRET=change-me-to-a-long-random-string

# Recommended in production: the site's public address. Redirects and link
# previews then always use it, whatever Host header a request claims.
# PUBLIC_URL=https://example.com

# Optional: fix the secret editor path yourself (16–128 letters, digits, - or _).
# By default a random one is generated on first start; see `npm run admin-url`.
# ADMIN_PATH=_my-own-long-unguessable-editor-path

# Optional bootstrap password. Only used if no password has been set with
# `npm run set-password` yet. Prefer the script; remove this afterwards.
# ADMIN_PASSWORD=

# Optional: Instagram API access token (Instagram API with Instagram Login,
# requires a Business or Creator account). Enables the live "feed" mode of
# the Instagram tile. Without it the tile can still show a profile card or
# embedded posts. See README.md > Instagram feed.
# INSTAGRAM_ACCESS_TOKEN=

# Optional: folder of design preset files (*.json) offered in the editor's
# Design panel. Default: presets/ in the install folder. Point several sites
# at one shared folder to give them all the same "house" presets.
# PRESETS_DIR=/etc/trellis/presets

# Optional: email notifications for contact-form messages. Special
# characters in the password must be URL-encoded (@ -> %40).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# NOTIFY_EMAIL=you@example.com
# SMTP_FROM=Trellis <noreply@example.com>

# Optional: request header with the visitor's country code (Statistics).
# Cloudflare sends CF-IPCountry (the default).
# GEO_HEADER=CF-IPCountry
